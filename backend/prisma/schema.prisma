generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  vendors          Vendor[]
  purchaseRequests PurchaseRequest[]
  quotes           Quote[]
  attachments      Attachment[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  inviteTokens     InviteToken[]
  quoteRequests    QuoteRequest[]
  inventoryItems   Inventory[]
  purchaseOrders   PurchaseOrder[]
  pipelines        ProcurementPipeline[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String   @unique
  password       String
  role           String   @default("manager") // admin, officer, manager (org_admin, procurement_officer, department_manager)
  department     String?
  bio            String?
  avatarStyle    String   @default("big-smile") // DiceBear style preference
  theme          String   @default("system") // light, dark, system
  notifyOnQuote      Boolean @default(true)
  notifyOnPO         Boolean @default(true)
  notifyOnStatus     Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseRequests PurchaseRequest[]
  activityLogs     ActivityLog[]
  attachments      Attachment[]
  notifications    Notification[]
  pipelines        ProcurementPipeline[]
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  category       String   // IT, Office Supplies, Furniture
  phone          String?
  onTimeDelivery Float    @default(95) // percentage
  defectRate     Float    @default(1)  // percentage
  rating         Float    @default(4.0) // 1-5 scale
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes         Quote[]
  quoteRequests  QuoteRequest[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, email])
}

model PurchaseRequest {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  itemName       String
  category       String
  quantity       Int
  budget         Float
  urgency        String   // low, medium, high, critical
  justification  String
  status         String   @default("pending") // pending, quoted, ordered, delivered
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  quotes      Quote[]
  attachments Attachment[]
  quoteRequests QuoteRequest[]
  purchaseOrders PurchaseOrder[]
  pipelines      ProcurementPipeline[]
}

model Quote {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prId           String
  vendorId       String
  price          Float
  deliveryDays   Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id])
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
}

model Attachment {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  filename       String
  originalName   String
  mimeType       String
  size           Int
  prId           String
  userId         String
  createdAt      DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
}

model InviteToken {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  token          String   @unique
  email          String
  role           String
  expiresAt      DateTime
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model QuoteRequest {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prId           String
  vendorId       String
  token          String   @unique
  status         String   @default("pending") // pending, sent, completed, expired
  expiresAt      DateTime
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id])
  vendor          Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([prId, vendorId])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String   // status_change, new_quote, po_issued, comment_added, vendor_added, user_invited, attachment_added
  title          String
  message        String?
  link           String?  // relative URL to navigate to (e.g., /pr/some-id)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Inventory {
  id             String   @id @default(uuid())
  itemName       String
  category       String
  quantity       Int      @default(0)
  minStockLevel  Int      @default(5)
  unitPrice      Float?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([itemName, organizationId])
}

model PurchaseOrder {
  id                String   @id @default(uuid())
  poNumber          String   @unique
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  totalAmount       Float
  status            String   @default("PENDING_APPROVAL")
  approvedBy        String?
  approvedAt        DateTime?
  sentAt            DateTime?
  expectedDelivery  DateTime?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  delivery          Delivery?
}

model Delivery {
  id                 String   @id @default(uuid())
  purchaseOrderId    String   @unique
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  status             String   @default("PREPARING")
  trackingNumber     String?
  estimatedArrival   DateTime?
  actualArrival      DateTime?
  notes              String?
  reminders          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProcurementPipeline {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  status            String   @default("PROCESSING") // PROCESSING, AWAITING_APPROVAL, APPROVED, REJECTED, COMPLETED, FAILED
  intent            Json?    // Parsed intent from user message
  recommendation    Json?    // AI recommendation data
  currentStep       String?  // Which step we're on
  stepsCompleted    Json?    // Array of completed steps
  userId            String
  user              User @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  action         String
  entity         String
  entityId       String?
  details        String?
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
