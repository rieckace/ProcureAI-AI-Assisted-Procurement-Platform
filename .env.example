# Docker Compose environment
# Copy this file to `.env` and adjust values as needed.
# All variables are optional — sensible defaults are used when they're missing.

# JWT secret used to sign authentication tokens.
# IMPORTANT: change this to a long random string before deploying publicly.
JWT_SECRET=dev-secret-change-me

# Groq API key (OPTIONAL) — enables the AI chat assistant and the autonomous
# procurement agent. Without it, the app still works but skips AI features.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Set to "false" to skip seeding demo data on the first database setup.
SEED_DATABASE=true
